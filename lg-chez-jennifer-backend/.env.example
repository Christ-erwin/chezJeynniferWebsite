# Port d'écoute de l'API
PORT=4000

# Origine(s) autorisée(s) pour CORS (le site Next.js), séparées par des virgules
FRONTEND_ORIGIN=http://localhost:3000

# URL publique du site (pages de retour après paiement)
FRONTEND_URL=http://localhost:3000

# URL publique de cette API (CinetPay doit pouvoir y POSTer le webhook)
PUBLIC_API_URL=http://localhost:4000/api

# --- Paiement Mobile Money : Wave + Orange Money via CinetPay ---
# Laisse vide en local : un SIMULATEUR de paiement est utilisé (aucun argent réel).
# Renseigne-les (dashboard CinetPay > Intégrations) pour encaisser pour de vrai.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Production uniquement : autoriser le simulateur (déconseillé)
# ALLOW_MOCK_PAYMENTS=false

# Fichier de stockage local des commandes (à remplacer par PostgreSQL en prod)
ORDERS_FILE=data/orders.json

# Base de données PostgreSQL (Supabase / Neon) — prochaine étape
# DATABASE_URL=

# --- Espace admin ---
# Accès complet (éditions, commandes, stats, contrôle)
ADMIN_PASSWORD=
# Équipe d'accueil : contrôle des billets uniquement (facultatif)
STAFF_PASSWORD=
# Clé de signature des sessions (32 caractères min) : openssl rand -hex 32
ADMIN_SECRET=

# Fichier de stockage des éditions (à remplacer par PostgreSQL en prod)
EVENTS_FILE=data/events.json

# --- Soirée Loup-Garou (parties, photos des joueurs) ---
# Fichier des parties et dossier des photos (à remplacer par PostgreSQL + stockage objet en prod)
GAMES_FILE=data/games.json
MEDIA_DIR=data/media
